  "signals": [
    {
      "id": "public-folders",
      "title": "Public folders",
      "enums": [ "WellKnownFolderName" ],
      "values": [ "PublicFoldersRoot" ],
      "coverage": "public-folders",
      "graph": "none",
      "note": "Graph has no API for public folders or their items."
    },
    {
      "id": "archive",
      "title": "Online archive mailbox",
      "enums": [ "WellKnownFolderName" ],
      "values": [ "ArchiveRoot", "ArchiveInbox", "ArchiveMsgFolderRoot", "ArchiveDeletedItems", "ArchiveRecoverableItemsRoot", "ArchiveRecoverableItemsDeletions", "ArchiveRecoverableItemsVersions", "ArchiveRecoverableItemsPurges", "ArchiveRecoverableItemsDiscoveryHolds" ],
      "coverage": "archive",
      "graph": "none in v1.0",
      "note": "Online archives are not in v1.0; Microsoft's roadmap lists them for the end of 2026."
    },
    {
      "id": "silent-meetings",
      "title": "SendToNone on appointments",
      "enums": [ "SendInvitationsMode", "SendCancellationsMode", "SendInvitationsOrCancellationsMode" ],
      "values": [ "SendToNone" ],
      "coverage": "calendar-meetings",
      "graph": "none",
      "note": "When a meeting has attendees, Graph sends them the invitation, update or cancellation; there is no switch for silent changes. Appointments without attendees are not affected."
    },
    {
      "id": "extended-properties",
      "title": "Extended properties",
      "types": [ "ExtendedPropertyDefinition" ],
      "graph": "$expand=singleValueExtendedProperties($filter=id eq '...'), multiValueExtendedProperties",
      "note": "A filter that only tests whether a property exists needs a value condition, such as ep/value ne null. Binary properties cannot be filtered. $search results ignore $expand, so read the properties in a second request."
    },
    {
      "id": "mime",
      "title": "MimeContent",
      "members": [ "ItemSchema.MimeContent", "Item.get_MimeContent", "Item.set_MimeContent" ],
      "coverage": "mail-mime",
      "graph": "GET /users/{id}/messages/{id}/$value",
      "note": "Creating a message from MIME makes a draft; it cannot become a received message this way."
    },
    {
      "id": "impersonation",
      "title": "Impersonation",
      "types": [ "ImpersonatedUserId" ],
      "coverage": "auth",
      "graph": "the mailbox in the URL: /users/{id}/...",
      "note": "Limit which mailboxes the app can open with RBAC for Applications in Exchange Online."
    },
    {
      "id": "contact-groups",
      "title": "Contact groups",
      "types": [ "ContactGroup" ],
      "coverage": "contacts-groups",
      "graph": "none in v1.0",
      "note": "Personal distribution lists have no API; Microsoft's roadmap lists them as planned."
    },
    {
      "id": "tasks",
      "title": "Tasks",
      "types": [ "Task" ],
      "coverage": "tasks",
      "graph": "/users/{id}/todo/lists/{id}/tasks (Microsoft To Do)",
      "note": "No extended properties. Progress is a status, so a percent complete of 25 is lost. No mileage, billing or work fields."
