{
  "operations": {
    "FindItem": {
      "graph": "GET /users/{id}/mailFolders/{id}/messages with $filter, $orderby, $top, $skip or $search; /calendarView for a CalendarView; /contacts; /todo/lists/{id}/tasks",
      "note": "With both $filter and $orderby, the sort properties must also be in the filter, in the same order and first, or Graph answers InefficientFilter. $search returns at most 1,000 results and cannot be combined with $filter or $orderby. No filter or sort on body text, size, item class by prefix, DisplayTo, DisplayCc or bitmasks, and no sort by an extended property."
    },
    "GetItem": {
      "graph": "GET /users/{id}/messages/{id}; events, contacts and To Do tasks have their own paths",
      "note": "Bodies come as HTML unless the request sends Prefer: outlook.body-content-type=\"text\". Times have whole seconds only."
    },
    "CreateItem": {
      "graph": "POST /users/{id}/messages; /events; /contacts; /todo/lists/{id}/tasks",
      "note": "A message created from MIME becomes a draft. Creating a meeting with attendees always sends the invitations."
    },
    "CreateItem (reply, forward)": {
      "soap": "CreateItem",
      "coverage": "mail-replies",
      "graph": "POST /users/{id}/messages/{id}/reply, replyAll, forward, createReply, createReplyAll, createForward"
    },
    "CreateItem (meeting response)": {
      "soap": "CreateItem",
      "coverage": "calendar-meetings",
      "graph": "POST /users/{id}/events/{id}/accept, decline, tentativelyAccept, cancel",
      "note": "Only a comment and sendResponse. Cc, Bcc, sensitivity and the folder for the saved response have no place to go."
    },
    "CreateItem (post)": {
      "soap": "CreateItem",
      "coverage": "posts",
      "graph": "none",
      "note": "Creating a post fails with ErrorObjectTypeChanged."
    },
    "CreateItem (SuppressReadReceipt)": {
      "soap": "CreateItem",
      "coverage": "mail-update",
      "graph": "none",
      "note": "Marking a message read sends the read receipt its sender asked for. There is no way to suppress it."
    },
    "UpdateItem": {
      "graph": "PATCH /users/{id}/messages/{id}; /events/{id}; /contacts/{id}",
      "note": "Marking a message read sends the read receipt its sender asked for. Changing a meeting notifies its attendees."
    },
    "DeleteItem": {
      "graph": "DELETE /users/{id}/messages/{id}; POST .../permanentDelete",
      "note": "DELETE puts the message in Deleted Items. permanentDelete matches HardDelete. For SoftDelete, move the message to recoverableitemsdeletions. Deleting a meeting sends the cancellation."
    },
    "MoveItem": {
      "graph": "POST /users/{id}/messages/{id}/move",
      "note": "The moved message gets a new ID unless you ask for immutable IDs. Events, contacts and tasks have no move."
    },
    "CopyItem": {
      "graph": "POST /users/{id}/messages/{id}/copy",
      "note": "Messages only. Events, contacts and tasks have no copy."
    },
    "SendItem": {
      "graph": "POST /users/{id}/messages/{id}/send or POST /users/{id}/sendMail",
      "note": "The copy always goes to Sent Items; sendMail can skip it with saveToSentItems: false, and neither call takes another folder. Both answer 202 with no ID."
    },
    "GetAttachment": {
      "graph": "GET /users/{id}/messages/{id}/attachments/{id}"
    },
    "CreateAttachment": {
      "graph": "POST /users/{id}/messages/{id}/attachments; createUploadSession for files over 3 MB",
      "note": "An attached item that has attachments of its own is accepted and its inner attachments are dropped."
    },
    "DeleteAttachment": {
      "graph": "DELETE /users/{id}/messages/{id}/attachments/{id}"
    },
    "Contact picture": {
      "coverage": "contacts-write",
      "graph": "/users/{id}/contacts/{id}/photo/$value"
    },
    "GetFolder": {
      "graph": "GET /users/{id}/mailFolders/{id}; /calendars/{id}; /contactFolders/{id}",
      "note": "Mail folders, calendars and contact folders are separate lists."
    },
    "FindFolder": {
      "graph": "GET /users/{id}/mailFolders, .../childFolders (?includeHiddenFolders=true for hidden ones); /calendars; /contactFolders",
      "note": "Mail folders, calendars and contact folders are separate lists."
    },
    "CreateFolder": {
      "graph": "POST /users/{id}/mailFolders or .../childFolders"
    },
    "UpdateFolder": {
      "graph": "PATCH /users/{id}/mailFolders/{id}"
    },
    "DeleteFolder": {
      "graph": "DELETE /users/{id}/mailFolders/{id}"
    },
    "MoveFolder": {
      "graph": "POST /users/{id}/mailFolders/{id}/move"
    },
    "CopyFolder": {
      "graph": "POST /users/{id}/mailFolders/{id}/copy"
    },
    "EmptyFolder": {},
    "MarkAllItemsAsRead": {},
    "SyncFolderItems": {
      "graph": "GET /users/{id}/mailFolders/{id}/messages/delta; /users/{id}/calendarView/delta for a calendar",
      "note": "A SyncState from EWS means nothing to Graph: do one full sync per folder after the switch. Delta reports net changes. Calendar delta needs a date window and returns occurrences, not series masters."
    },
    "SyncFolderHierarchy": {
      "graph": "GET /users/{id}/mailFolders/delta",
      "note": "Mail folders only."
    },
    "Subscribe (pull)": {
      "soap": "Subscribe",
      "graph": "delta queries",
      "note": "You poll, and you get net changes, not each event."
    },
    "Subscribe (push)": {
      "soap": "Subscribe",
      "coverage": "notifications-push",
      "graph": "POST /subscriptions with a webhook URL",
      "note": "Subscriptions expire and must be renewed; the webhook must be reachable from the internet."
    },
    "Subscribe (streaming)": {
      "soap": "Subscribe",
      "graph": "none",
      "note": "No long-running connection. Use a webhook subscription or poll delta queries."
    },
    "GetEvents": {
      "graph": "delta queries, for example GET /users/{id}/mailFolders/{id}/messages/delta",
      "note": "You poll, and you get net changes, not each event."
    },
    "GetStreamingEvents": {
      "graph": "none",
      "note": "No long-running connection. Use a webhook subscription or poll delta queries."
    },
    "Unsubscribe": {
      "graph": "DELETE /subscriptions/{id} for a webhook subscription"
    },
    "ConvertId": {
      "graph": "POST /users/{id}/translateExchangeIds",
      "note": "Up to 1,000 IDs per call. Ask for immutable IDs (Prefer: IdType=\"ImmutableId\") if you store IDs."
    },
    "ResolveNames": {
      "graph": "GET /users/{id}/people (Microsoft's mapping) or GET /users?$search=\"displayName:...\" with ConsistencyLevel: eventual",
      "note": "Matching rules differ from EWS ambiguous name resolution."
    },
    "ExpandDL": {
      "graph": "GET /groups/{id}/members or transitiveMembers",
      "note": "Groups are found by ID, not by SMTP address; look the group up first."
    },
    "GetUserAvailability": {
      "graph": "POST /users/{id}/calendar/getSchedule",
      "note": "Other people's calendars come at free/busy level only."
    },
    "GetRoomLists": {
      "graph": "GET /places/microsoft.graph.roomlist"
    },
    "GetRooms": {
      "graph": "GET /places/{room list address}/microsoft.graph.roomlist/rooms"
    },
    "GetUserOofSettings": {
      "graph": "GET /users/{id}/mailboxSettings (automaticRepliesSetting)",
      "note": "No AllowExternalOof, and no language for the reply text."
    },
    "SetUserOofSettings": {
      "graph": "PATCH /users/{id}/mailboxSettings (automaticRepliesSetting)",
      "note": "No AllowExternalOof, and no language for the reply text."
    },
    "GetInboxRules": {
      "graph": "GET /users/{id}/mailFolders/inbox/messageRules",
      "note": "WithinDateRange, FromConnectedAccounts, ItemClasses, MessageClassifications, SendSMSAlertToRecipients and ServerReplyWithMessage are missing."
    },
    "UpdateInboxRules": {
      "graph": "POST, PATCH and DELETE /users/{id}/mailFolders/inbox/messageRules",
      "note": "Updating a rule replaces all its conditions, exceptions and actions. WithinDateRange, FromConnectedAccounts, ItemClasses, MessageClassifications, SendSMSAlertToRecipients and ServerReplyWithMessage are missing."
    },
    "GetDelegate": {
      "graph": "GET /users/{id}/calendar/calendarPermissions",
      "note": "Calendar only. Delegate access to Inbox, Tasks, Contacts, Notes and Journal is not there."
    },
    "AddDelegate": {
      "graph": "POST /users/{id}/calendar/calendarPermissions",
      "note": "Calendar only. Delegate access to Inbox, Tasks, Contacts, Notes and Journal is not there."
    },
    "UpdateDelegate": {
      "graph": "PATCH /users/{id}/calendar/calendarPermissions/{id}",
      "note": "Calendar only. Delegate access to Inbox, Tasks, Contacts, Notes and Journal is not there."
    },
    "RemoveDelegate": {
      "graph": "DELETE /users/{id}/calendar/calendarPermissions/{id}",
      "note": "Calendar only. Delegate access to Inbox, Tasks, Contacts, Notes and Journal is not there."
    },
    "FindConversation": {},
    "GetConversationItems": {},
    "ApplyConversationAction": {},
    "MarkAsJunk": {},
    "FindPeople": {
      "graph": "GET /users/{id}/people"
    },
